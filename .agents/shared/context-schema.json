{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA Agents Shared Context",
  "type": "object",
  "required": [
    "version",
    "workflow_id",
    "requested_at",
    "status",
    "stages",
    "artifacts"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 8
    },
    "requested_at": {
      "type": "string",
      "description": "ISO-8601 timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "blocked"]
    },
    "request": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "scope": { "type": "string" },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "object",
      "required": [
        "documentation",
        "planning",
        "prioritization",
        "generation",
        "automation"
      ],
      "properties": {
        "documentation": { "$ref": "#/$defs/stage" },
        "planning": { "$ref": "#/$defs/stage" },
        "prioritization": { "$ref": "#/$defs/stage" },
        "generation": { "$ref": "#/$defs/stage" },
        "automation": { "$ref": "#/$defs/stage" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "documentation_artifact": { "$ref": "#/$defs/artifact" },
        "test_plan_artifact": { "$ref": "#/$defs/artifact" },
        "priority_matrix_artifact": { "$ref": "#/$defs/artifact" },
        "generated_test_cases_artifact": { "$ref": "#/$defs/artifact" },
        "automation_artifact": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": true
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "artifact", "agent"],
        "properties": {
          "requirement_id": { "type": "string" },
          "artifact": { "type": "string" },
          "agent": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["status", "owner_agent"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "blocked"]
        },
        "owner_agent": { "type": "string" },
        "started_at": { "type": "string" },
        "finished_at": { "type": "string" },
        "blocking_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["missing", "draft", "ready"]
        },
        "path": { "type": "string" },
        "format": {
          "type": "string",
          "enum": ["json", "md", "ts"]
        },
        "updated_by": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
